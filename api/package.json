{
  "name": "taskflow-api",
  "version": "1.0.0",
  "description": "TaskFlow API - petite API Express à déployer et à surveiller (fil rouge Automatisation CI & Monitoring)",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "lint": "eslint src/ tests/",
    "format": "prettier --write src/ tests/",
    "format:check": "prettier --check src/ tests/",
    "build": "node --check src/server.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ci": "vitest run --reporter=default --reporter=junit --outputFile=reports/junit.xml --coverage"
  },
  "dependencies": {
    "express": "^4.19.2",
    "prom-client": "^15.1.3"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^5.0.1",
    "eslint": "^9.0.0",
    "prettier": "^3.3.0",
    "supertest": "^7.0.0",
    "vitest": "^5.0.1"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT"
}
